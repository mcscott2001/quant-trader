# Copy this file to ".env" (same folder) and paste in your Trading 212 API key:
#     cp .env.example .env        (Windows: copy .env.example .env)
#     nano .env
# Keep .env private. Never share it, email it or upload it anywhere.
#
# Make the key in the Trading 212 app: Menu > Settings > API (Beta) > Generate API key.
# Make it while the app is on the SAME account that config.yaml live.mode points at:
#   live.mode: demo  ->  a key made in your Practice account
#   live.mode: live  ->  a key made in your real Invest (or Stocks ISA) account

T212_API_KEY=paste_your_api_key_here
T212_API_SECRET=paste_your_api_secret_here
